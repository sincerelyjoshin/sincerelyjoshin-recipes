<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Identifier</key>
    <string>com.github.sincerelyjoshin-recipes.pkg.zotero</string>
    <key>Description</key>
    <string>Packages the Zotero app from the downloaded DMG.</string>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>ParentRecipe</key>
    <string>com.github.joshua-d-miller.download.zotero</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Zotero</string>
    </dict>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>AppPkgCreator</string>
        </dict>
    </array>
</dict>
</plist>
